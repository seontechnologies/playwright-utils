// if this file changes
// npm run db:migrate
// npm run db:sync
// npm run reset:db

generator client {
  provider     = "prisma-client"
  output       = "../generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "sqlite"
}

model Movie {
  id       Int    @id @default(autoincrement())
  name     String
  year     Int
  rating   Float
  director String
}
