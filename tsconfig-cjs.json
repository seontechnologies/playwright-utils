{
  "extends": "./tsconfig.json",
  "include": ["src"],
  "exclude": ["jest.config.*s", "**/*.test.ts"],
  "compilerOptions": {
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "module": "Node16",
    "moduleResolution": "Node16",
    "noEmit": false,
    "rootDir": "src",
    "outDir": "dist/cjs",
    "target": "es2020",
    "lib": ["es2022", "dom"]
  }
}
